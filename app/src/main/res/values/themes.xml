<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FF07060F</color>
    <color name="icon_bg">#FF0B0820</color>
    <style name="Theme.IEP" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
    <!-- Launch splash (logo on dark); stays up while the app open ad loads. -->
    <style name="Theme.IEP.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.IEP</item>
    </style>
</resources>
